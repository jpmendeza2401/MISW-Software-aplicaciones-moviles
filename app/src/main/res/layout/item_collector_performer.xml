<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="6dp"
    app:cardBackgroundColor="#1C1A16"
    app:cardCornerRadius="12dp"
    app:strokeColor="#D8AD4A"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <ImageView
            android:id="@+id/performerImage"
            android:layout_width="match_parent"
            android:layout_height="170dp"
            android:scaleType="centerCrop"
            android:contentDescription="Imagen del artista"/>

        <TextView
            android:id="@+id/performerName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#D8AD4A"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginTop="10dp"/>

        <TextView
            android:id="@+id/performerDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#F5F0E6"
            android:textSize="14sp"
            android:layout_marginTop="6dp"/>

        <TextView
            android:id="@+id/performerDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#D8AD4A"
            android:textSize="12sp"
            android:layout_marginTop="8dp"/>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
