<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".ui.AlbumDetailActivity">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/groove_canvas"
        app:navigationContentDescription="@string/volver"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:title="@string/detalle_album"
        app:titleTextAppearance="@style/Groove.Text.Section"
        app:titleTextColor="@color/groove_text_primary" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/groove_hairline" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ProgressBar
            android:id="@+id/progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminateTint="@color/groove_primary"
            android:visibility="gone" />

        <TextView
            android:id="@+id/errorText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:padding="16dp"
            android:text="@string/error_generico"
            style="@style/Groove.Text.Body"
            android:visibility="gone" />

        <ScrollView
            android:id="@+id/content"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/coverImage"
                        android:layout_width="120dp"
                        android:layout_height="120dp"
                        android:background="@drawable/bg_cover_placeholder"
                        android:contentDescription="@string/portada"
                        android:scaleType="centerCrop" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/nameText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            style="@style/Groove.Text.Headline" />

                        <TextView
                            android:id="@+id/performersText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            style="@style/Groove.Text.Body" />

                        <TextView
                            android:id="@+id/releaseDateText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            style="@style/Groove.Text.Body" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/genero"
                        style="@style/Groove.Text.Body" />

                    <TextView
                        android:id="@+id/genreText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/Groove.Text.Title" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/sello_discografico"
                        style="@style/Groove.Text.Body" />

                    <TextView
                        android:id="@+id/recordLabelText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/Groove.Text.Title" />
                </LinearLayout>

                <TextView
                    android:id="@+id/descriptionText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    style="@style/Groove.Text.Body" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="@string/tracks_title"
                    style="@style/Groove.Text.Section" />

                <TextView
                    android:id="@+id/tracksEmptyText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/tracks_empty"
                    style="@style/Groove.Text.Body"
                    android:visibility="gone" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/tracksList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:nestedScrollingEnabled="false"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

                <!-- HU08: agregar track. Solo visible para el coleccionista en sesión. -->
                <LinearLayout
                    android:id="@+id/addTrackSection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_card"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/add_track_title"
                        style="@style/Groove.Text.Section" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:labelFor="@id/trackNameInput"
                        android:text="@string/add_track_name_label"
                        style="@style/Groove.Text.Label" />

                    <EditText
                        android:id="@+id/trackNameInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:autofillHints=""
                        android:background="@drawable/bg_input"
                        android:inputType="textCapWords"
                        android:maxLines="1"
                        android:padding="14dp"
                        android:textColor="@color/groove_text_primary"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:labelFor="@id/trackDurationInput"
                        android:text="@string/add_track_duration_label"
                        style="@style/Groove.Text.Label" />

                    <EditText
                        android:id="@+id/trackDurationInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:autofillHints=""
                        android:background="@drawable/bg_input"
                        android:hint="@string/add_track_duration_hint"
                        android:inputType="datetime"
                        android:maxLength="5"
                        android:maxLines="1"
                        android:padding="14dp"
                        android:textColor="@color/groove_text_primary"
                        android:textColorHint="@color/groove_text_subtle"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/trackErrorText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:textColor="#FF8A80"
                        android:textSize="13sp"
                        android:visibility="gone"
                        tools:text="La duración mínima es 1 minuto (1:00)."
                        tools:visibility="visible" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/addTrackButton"
                        style="@style/Groove.Button.Primary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="@string/add_track_save"
                        app:icon="@drawable/ic_send" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="@string/comments_title"
                    style="@style/Groove.Text.Section" />

                <TextView
                    android:id="@+id/commentsEmptyText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/comments_empty"
                    style="@style/Groove.Text.Body"
                    android:visibility="gone" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/commentsList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:nestedScrollingEnabled="false"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

                <!-- HU09: publicar comentario. Solo visible si CollectorSession.current?.id_usuario tiene valor (coleccionista). -->
                <LinearLayout
                    android:id="@+id/addCommentSection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_card"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/add_comment_title"
                        style="@style/Groove.Text.Section" />

                    <TextView
                        android:id="@+id/commentAuthorText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        style="@style/Groove.Text.Meta"
                        tools:text="Publicando como Manolo Bellon" />

                    <!-- Calificación -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:text="@string/add_comment_rating_label"
                        style="@style/Groove.Text.Label" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/add_comment_rating_hint"
                        style="@style/Groove.Text.Meta"
                        android:textSize="12sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <RatingBar
                            android:id="@+id/commentRatingBar"
                            style="?android:attr/ratingBarStyle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:isIndicator="false"
                            android:numStars="5"
                            android:progressBackgroundTint="@color/groove_text_subtle"
                            android:progressTint="@color/groove_primary"
                            android:rating="5"
                            android:secondaryProgressTint="@color/groove_primary"
                            android:stepSize="1" />

                        <Space
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:layout_weight="1" />

                        <TextView
                            android:id="@+id/commentRatingValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_rating_chip"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:paddingVertical="6dp"
                            android:textColor="@color/groove_primary"
                            style="@style/Groove.Text.Title"
                            tools:text="5.0" />
                    </LinearLayout>

                    <!-- Descripción -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:labelFor="@id/commentDescriptionInput"
                            android:text="@string/add_comment_description_label"
                            style="@style/Groove.Text.Label" />

                        <TextView
                            android:id="@+id/commentCounterText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            style="@style/Groove.Text.Meta"
                            android:textSize="12sp"
                            tools:text="0 / 600" />
                    </LinearLayout>

                    <EditText
                        android:id="@+id/commentDescriptionInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:autofillHints=""
                        android:background="@drawable/bg_input"
                        android:gravity="top|start"
                        android:hint="@string/add_comment_description_hint"
                        android:inputType="textMultiLine|textCapSentences"
                        android:maxLength="600"
                        android:minLines="4"
                        android:padding="14dp"
                        android:textColor="@color/groove_text_primary"
                        android:textColorHint="@color/groove_text_subtle"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/commentErrorText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:textColor="#FF8A80"
                        android:textSize="13sp"
                        android:visibility="gone"
                        tools:text="Escribe la descripción del comentario."
                        tools:visibility="visible" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/publishCommentButton"
                        style="@style/Groove.Button.Primary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:text="@string/add_comment_publish"
                        app:icon="@drawable/ic_send" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/cancelCommentButton"
                        style="@style/Groove.Button.Secondary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/add_comment_cancel"
                        app:icon="@drawable/ic_close" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </FrameLayout>

    <!-- Navegación inferior: la misma barra del listado de álbumes y de coleccionistas -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#1C1A16"
        app:menu="@menu/bottom_navigation_menu"
        app:itemIconTint="#D8AD4A"
        app:itemTextColor="#F5F0E6"
        app:labelVisibilityMode="labeled"
        app:elevation="8dp" />
</LinearLayout>
