<?xml version="1.0" encoding="utf-8"?>
<!-- Versión pequeña de vinyl_record para las tarjetas del listado (HU05):
     borde más delgado y un surco interior para que se lea como disco a 56dp. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="#24221F" />
            <stroke
                android:width="2dp"
                android:color="#55504A" />
        </shape>
    </item>
    <item
        android:bottom="7dp"
        android:left="7dp"
        android:right="7dp"
        android:top="7dp">
        <shape android:shape="oval">
            <solid android:color="@android:color/transparent" />
            <stroke
                android:width="1dp"
                android:color="#3A3631" />
        </shape>
    </item>
</layer-list>
